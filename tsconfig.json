{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJs",
    "rootDir": "src",
    "baseUrl": "./",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules"],
  "ts-node": {
    "files": true
  }
}
