# Server Configuration
PORT=5001
APP_NAME=ledgerio-api-v0
NODE_ENV=development

# Database Configuration
# Format: postgresql://user:password@host:port/database
PSQL_DB_URL=postgresql://postgres:password@localhost:5432/ledgerio

# JWT Secrets (Change these in production!)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Token Expiration Times
# Examples: 15m, 1h, 7d, 30d
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Logging Configuration
# Options: error, warn, info, verbose, debug
LOG_LEVEL=info

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vin_check
POSTGRES_PORT=5432
DOMAIN=vin-check-api.alexalexdev.io
DB_HOST_PORT=5432
