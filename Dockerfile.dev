FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

COPY entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh
RUN chmod +x /usr/local/bin/entrypoint.dev.sh

ARG PORT=5001
ENV PORT=${PORT}
EXPOSE ${PORT}

ENTRYPOINT ["entrypoint.dev.sh"]
CMD ["npm", "run", "dev"]
